# Dependencies — must be installed on each machine (npm ci / npm install).
# NEVER commit: .bin shims written on Windows lose the exec bit / get CRLF,
# which makes `npm run build` fail with exit 126 on Linux deploy hosts.
node_modules/

# Build output — regenerated by `npm run build` on deploy.
dist/

# Local env / secrets
.env
.env.*
!.env.example

# Logs & local tooling state
*.log
*.log.err
.freebuff/
coverage/
.vite/
